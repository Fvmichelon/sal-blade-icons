{
    "name": "fvmichelon/sal-blade-icons",
    "description": "Blade Icons package with regular (real stroke), fill, and duotone families. Based on Phosphor Icons (MIT).",
    "keywords": [
        "Blade",
        "Laravel",
        "icons",
        "SVG",
        "sal"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "SAL"
        },
        {
            "name": "Phosphor Icons",
            "homepage": "https://phosphoricons.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "blade-ui-kit/blade-icons": "^1.6",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Sal\\SalBladeIcons\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sal\\SalBladeIcons\\SalBladeIconsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
